// Shared build settings. Personal values live in Secrets.xcconfig (git-ignored).

// Developer Mode works with these placeholders. Replace them with the IDs from the
// Wearables Developer Center if you register Vesper there.
META_APP_ID = 0
CLIENT_TOKEN = 0

// Apple granted the CarPlay Driving Task entitlement (2026-11-04). The plain
// Vesper.entitlements file is kept for builds on a team without it.
VESPER_ENTITLEMENTS = App/Vesper/Resources/Vesper-CarPlay.entitlements

#include? "Secrets.xcconfig"
